# Copy to .env (repo root). Both /api and /web read it.

# ---- API ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Reverse proxies in front of the API (1 on Render/Railway) so rate limits see real client IPs
TRUST_PROXY=0

# ---- Database ----
DATABASE_URL=mysql://mailcheck:mailcheck@localhost:3307/mailcheck
# Used only by `npm test`
TEST_DATABASE_URL=mysql://mailcheck:mailcheck@localhost:3307/mailcheck_test
DB_POOL_SIZE=10

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---- Credits & rate limiting ----
FREE_CREDITS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=60
# Public landing-page demo endpoint, per IP
DEMO_RATE_LIMIT_MAX=10

# ---- Verifier ----
# Many hosts and ISPs block outbound port 25. Leave false unless you know it is open.
SMTP_CHECK_ENABLED=false
SMTP_TIMEOUT_MS=8000
SMTP_HELO_DOMAIN=mailcheck.local
SMTP_MAIL_FROM=verify@mailcheck.local
DNS_TIMEOUT_MS=5000
MX_CACHE_TTL_SECONDS=300

# ---- Bulk jobs / worker ----
BULK_MAX_ROWS=1000
WORKER_CONCURRENCY=10
WORKER_POLL_INTERVAL_MS=1000
# Minimum gap between checks against the same domain
DOMAIN_THROTTLE_MS=250
# Seconds before a claimed-but-unfinished item is handed to another worker
WORKER_LOCK_SECONDS=60
BULK_MAX_ATTEMPTS=3
# Retry delay = this x attempt number
BULK_RETRY_DELAY_SECONDS=2

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
